<!-- Enter new dept -->
@model Department

<h1>Add</h1>

<!-- /Department/SaveAdd?Name=ali&Mgrname=Ismail -->

<form action="/Department/SaveAdd" method="get">
	<div>
		<label>Name</label>
		<input type="text" name="Name" value="@Model?.Name" id="Name" class="form-control" />
	</div>
	<div>
		<label>Manager Name</label>
		<input type="text" name="Mgrname" value="@Model?.Mgrname" id="Mgrname" class="form-control" />
	</div>
	<input type="submit" value="Add" class="btn btn-primary mt-3"/>
</form>

<a href="/Department/Index">back To List</a>