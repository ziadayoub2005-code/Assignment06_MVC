@model List<Department>

@{
	Layout = "_ourlayout";
}

<h1 style="color:white">Departments</h1>

<!-- All Departments in Table -->
<!-- C# property - Data received - Model -->
<!--  Model - Data type?! - dynamic  -->
<!-- clean - less errors - time less Develop  -->

<a href="/Department/Add" class="btn btn-success mb-3">New</a>
<table style="color:white" class="table table-hover table-bordered">
	<tr>
		<th>Number</th>
		<th>Name</th>
		<th>EmpCount</th>
	</tr>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item?.Id</td>
			<td>@item?.Name</td>
			<td>@item?.Emps?.Count</td>
		</tr>
	}
</table>