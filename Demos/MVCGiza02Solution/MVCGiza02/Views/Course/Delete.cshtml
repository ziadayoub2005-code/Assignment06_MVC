@model Course

@{
    ViewData["Title"] = "Delete Course";
}

<h2 class="text-danger">Delete Course</h2>
<h4 class="text-muted">Are you sure you want to delete this course?</h4>

<div class="card p-3 col-md-6 border-danger mt-3">
    <dl class="row">
        <dt class="col-sm-4">Course Name</dt>
        <dd class="col-sm-8">@Model.Name</dd>

        <dt class="col-sm-4">Total Degree</dt>
        <dd class="col-sm-8">@Model.Degree</dd>

        <dt class="col-sm-4">Min Degree</dt>
        <dd class="col-sm-8">@Model.MinDegree</dd>

        <dt class="col-sm-4">Hours</dt>
        <dd class="col-sm-8">@Model.Hours</dd>
    </dl>

    <form method="post" asp-action="ConfirmDelete" asp-route-id="@Model.Id">
        <input type="submit" value="Yes, Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
